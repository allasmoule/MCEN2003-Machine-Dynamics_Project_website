{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/admin/admin.css",
      "dest": "/admin/admin.css"
    },
    {
      "src": "/admin/index.html",
      "dest": "/admin/index.html"
    },
    {
      "src": "/admin/index.php",
      "dest": "/admin/index.html"
    },
    {
      "src": "/admin/subjects.php",
      "dest": "/admin/index.html#subjects"
    },
    {
      "src": "/admin/tutorials.php",
      "dest": "/admin/index.html#tutorials"
    },
    {
      "src": "/admin/questions.php",
      "dest": "/admin/index.html#questions"
    },
    {
      "src": "/admin/formula_sheet.php",
      "dest": "/admin/index.html#formula"
    },
    {
      "src": "/admin/messages.php",
      "dest": "/admin/index.html"
    },
    {
      "src": "/admin/videos.php",
      "dest": "/admin/index.html#videos"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin/index.html"
    },
    {
      "src": "/admin",
      "dest": "/admin/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
