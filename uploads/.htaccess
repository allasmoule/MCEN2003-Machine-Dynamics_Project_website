# Uploaded slides / PDFs are files to download, never scripts to run.
<FilesMatch "\.(php|phtml|phar|php\d|pl|py|cgi|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -ExecCGI
