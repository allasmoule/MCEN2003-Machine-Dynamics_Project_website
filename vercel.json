{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "subject.html",
      "use": "@vercel/static"
    },
    {
      "src": "login.html",
      "use": "@vercel/static"
    },
    {
      "src": "tutorial1.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "api/**",
      "use": "@vercel/static"
    },
    {
      "src": "admin/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/admin/index.php",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/subjects.php",
      "destination": "/admin/index.html#subjects"
    },
    {
      "source": "/admin/tutorials.php",
      "destination": "/admin/index.html#tutorials"
    },
    {
      "source": "/admin/questions.php",
      "destination": "/admin/index.html#questions"
    },
    {
      "source": "/admin/formula_sheet.php",
      "destination": "/admin/index.html#formula"
    },
    {
      "source": "/admin/messages.php",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/videos.php",
      "destination": "/admin/index.html#videos"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ]
}
